import("//build/config/sysroot.gni")

declare_args() {
  # QURAN BUILD: Xcode 27 SDK `.tbd` stubs list `arm64e.x1` targets the
  # vendored ld64.lld (Fuchsia LLD 23) rejects as "unknown architecture",
  # failing every Mac/iOS link; when set, clang is pointed at this linker
  # instead (Xcode's `ld`).
  mac_ld_path = ""
}

# QURAN BUILD: `sdk` (not `mac_dynamic_flags` below) is where this lives
# because it is the one config `//build/config/BUILDCONFIG.gn` applies to
# every native target type (executable, shared_library, static_library) on
# both mac (`is_mac`) and iOS (`is_ios` — see the matching block in
# `//build/config/ios/BUILD.gn`), via `_native_compiler_configs`.
# `mac_dynamic_flags`/`mac_executable_flags` below are `is_mac`-only and are
# not part of an iOS shared_library's default configs (verified: the failing
# `ios_profile` SOLINK command carries none of their flags), so putting the
# `--ld-path` override there alone would not fix an iOS link.
config("sdk") {
  cflags_cc = [ "-stdlib=libc++" ]
  # QURAN BUILD: Xcode 27's `os/trace_base.h` (in the macOS SDK) marks its log
  # macros with an attribute (`stack_protector_ignore`) the vendored clang
  # ignores once `-fstack-protector-all` is on — an `is_official_build`/release
  # flag — which `-Werror` then promotes to a hard error in any release build
  # that happens to expand one of those macros (hit in `third_party/angle`, a
  # DEPS checkout with its own `-Werror`, building `host_release`). Silencing
  # just this warning class, not `-fstack-protector-all` or `-Werror`
  # themselves, is the minimal fix. Desktop-Mac host targets only (`sdk` here,
  # not the mirrored one in `//build/config/ios/BUILD.gn`) — the failure is
  # specific to `-fstack-protector-all` release host builds.
  cflags = [ "-Wno-ignored-attributes" ]
  ldflags = []
  if (mac_ld_path != "") {
    ldflags += [ "--ld-path=" + mac_ld_path ]
  }
}

# On Mac, this is used for everything except static libraries.
config("mac_dynamic_flags") {
  ldflags = [
    "-Wl,-search_paths_first",
    "-L.",

    # Path for loading shared libraries for unbundled binaries.
    "-Wl,-rpath,@loader_path/.",
    "-Wl,-rpath,/usr/local/lib/.",

    # Path for loading shared libraries for bundled binaries. Get back from
    # Binary.app/Contents/MacOS.
    "-Wl,-rpath,@loader_path/../../..",
  ]
}

# On Mac, this is used only for executables.
config("mac_executable_flags") {
  ldflags = [ "-Wl,-pie" ]  # Position independent.
}
